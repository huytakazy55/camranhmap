# Sao chép thành web/.env.local khi chạy `npm run dev`.
# Khi chạy Docker, đặt cùng các biến NEXT_PUBLIC_* trong file .env ở thư mục gốc dự án (docker compose tự đọc).

# Địa chỉ API .NET (phía máy chủ Next gọi, trình duyệt không gọi trực tiếp)
API_URL=http://localhost:5080

# Địa chỉ công khai của web: dùng cho canonical, sitemap, JSON-LD
SITE_URL=http://localhost:3000

# Chỉ đặt true khi chạy thật với dữ liệu thật. Mặc định: noindex toàn site + robots.txt chặn hết.
# ALLOW_INDEXING=true

# Ảnh nền: xem giải thích trong src/lib/map/imagery.ts
NEXT_PUBLIC_ARCGIS_API_KEY=
# NEXT_PUBLIC_IMAGERY_URL=https://tiles.example.com/camranh/{z}/{x}/{y}.jpg
# NEXT_PUBLIC_IMAGERY_MAXZOOM=20
# NEXT_PUBLIC_IMAGERY_ATTRIBUTION=Ảnh © Công ty của bạn

# Mật khẩu vào /admin (thêm bất động sản). Không đặt thì tắt hẳn khu quản trị và việc ghi dữ liệu.
# Dùng chuỗi dài, ngẫu nhiên: `openssl rand -base64 18`. Docker: đặt trong .env ở thư mục gốc.
ADMIN_PASSWORD=
